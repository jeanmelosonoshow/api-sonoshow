# Na Vercel: token de leitura entregue ao Club Moveleiro (gere um segredo longo).
API_BEARER_TOKEN=
# Na Vercel e no Windows: outro token, exclusivo para publicar o cache.
SYNC_BEARER_TOKEN=
# Somente na Vercel, no modo 2:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Se a integracao da Vercel criou KV_REST_API_URL e KV_REST_API_TOKEN,
# esses nomes tambem sao aceitos e substituem as duas variaveis acima.
# Somente no Windows, modo 2. URL da SUA API publicada, sem barra final.
INTEGRATION_API_URL=
# Na Vercel (modo 1) ou no Windows (modo 2): credencial exclusiva do Gateway.
# No Windows TS, FIREBIRD_GATEWAY_URL também pode ser http://127.0.0.1:8787.
FIREBIRD_GATEWAY_URL=https://gateway.jgmelo.company
FIREBIRD_GATEWAY_TOKEN_ID=
FIREBIRD_GATEWAY_HMAC_SECRET=
