# Na Vercel: token de leitura entregue ao Club Moveleiro (gere um segredo longo).
API_BEARER_TOKEN=
# Na Vercel e no Windows: outro token, exclusivo para publicar o cache.
SYNC_BEARER_TOKEN=
# Somente na Vercel, no modo 2:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Somente no Windows, modo 2. URL da SUA API publicada, sem barra final.
INTEGRATION_API_URL=
# No Windows (modo 2) ou na Vercel (modo 1). Use um usuario somente leitura.
FIREBIRD_HOST=127.0.0.1
FIREBIRD_PORT=3050
FIREBIRD_DATABASE=
FIREBIRD_USER=
FIREBIRD_PASSWORD=
FIREBIRD_ENCODING=UTF8
